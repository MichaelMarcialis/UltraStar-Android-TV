<?xml version="1.0" encoding="utf-8"?>
<!--
   Everything is backed up except the USDB login. A password that rides a cloud backup off the
   device is a password stored somewhere nobody chose to store it, and it is worth nothing to a
   restore anyway: the account is the user's, and signing in again is one screen.
   Used on API 30 and below; API 31+ reads data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="usdb_account.xml" />
</full-backup-content>
