<?xml version="1.0" encoding="utf-8"?>
<!--
   See backup_rules.xml for the reasoning. Excluded from both cloud backup and device-to-device
   transfer: a new device should ask for the login rather than inherit it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="usdb_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="usdb_account.xml" />
    </device-transfer>
</data-extraction-rules>
